# AI Pool Connection — copy to .env or export these as environment variables / secrets.
# Add ONLY keys for accounts you legitimately own. One key per provider.
# The app prefers free/open models first, then paid providers, and never
# pools or rotates tokens across accounts to bypass provider limits.

# Grok via official xAI API
XAI_API_KEY=

# Fast, generous free tier for open models (Llama, etc.)
GROQ_API_KEY=

# Gateway to many open/free models including Hermes 3
OPENROUTER_API_KEY=

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CodeCraft shared gateway — same contract as the collaborating agent's
# tools/codecraft-client.mjs. No request is made until both of these are set.
# CODECRAFT_BASE_URL=https://api.groq.com/openai/v1
# CODECRAFT_API_KEY=
# CODECRAFT_MODEL=gpt-4o-mini
# CODECRAFT_TIER=free

# Local open models via Ollama (no key, no cost). Set host to enable.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=hermes3

# Spend cap (USD) for paid providers. Default 1.
BUDGET_USD=1

# Web server port (default 8787)
PORT=8787

# Network binding. Defaults to 127.0.0.1 (local-only). Only set 0.0.0.0 to
# expose it, and if you do, ALWAYS set SERVER_AUTH_TOKEN below.
# HOST=127.0.0.1

# Require this bearer token on every /api call. Strongly recommended before
# exposing the server beyond localhost. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# SERVER_AUTH_TOKEN=

# Max API requests per client IP per minute (default 30)
RATE_LIMIT_PER_MIN=30
