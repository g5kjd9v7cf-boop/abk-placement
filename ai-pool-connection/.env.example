# AI Pool Connection — copy to .env or export these as environment variables / secrets.
# Add ONLY keys for accounts you legitimately own. One key per provider.
# The app prefers free/open models first, then paid providers, and never
# pools or rotates tokens across accounts to bypass provider limits.

# Grok via official xAI API
XAI_API_KEY=

# Fast, generous free tier for open models (Llama, etc.)
GROQ_API_KEY=

# Gateway to many open/free models including Hermes 3
OPENROUTER_API_KEY=

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local open models via Ollama (no key, no cost). Set host to enable.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=hermes3

# Spend cap (USD) for paid providers. Default 1.
BUDGET_USD=1

# Web server port (default 8787)
PORT=8787
